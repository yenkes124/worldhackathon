# --- Local runtime (default; no key needed) ---------------------------------
# `reactor run` in ../model serves the model on http://localhost:8080.
VITE_REACTOR_LOCAL=true
VITE_REACTOR_MODEL=neurogrid

# --- Hosted (after `reactor model deploy` succeeds) -------------------------
# VITE_REACTOR_LOCAL=false
# VITE_REACTOR_MODEL=<your-account>/neurogrid
# Server-side only. Never exposed to the browser; the token route exchanges it
# for a short-lived JWT scoped to VITE_REACTOR_MODEL.
# REACTOR_API_KEY=rk_...
