# .dockerignore — files excluded from the image by `COPY . /app/`.
# Edit to include/exclude per your project layout.

# Python build / cache artefacts
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local Python venvs — the image installs its own dependencies.
.venv/
venv/

# Editor / IDE state
.vscode/
.idea/
*.swp

# OS metadata
.DS_Store
Thumbs.db

# Source control
.git/
.gitignore

# Docker config — already consumed by `docker build`, no need to ship.
Dockerfile
.dockerignore

# Weights are not baked into the image: `reactor model deploy` ships
# runtime.weights_path with the release, a local run mounts it, and the model
# reads both through get_weights_path().
weights/
tests/
fixtures/
